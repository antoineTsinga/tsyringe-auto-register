# Normalize all text files to LF in the repo
* text=auto eol=lf

# Treat these as text explicitly
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.yml text
*.yaml text
*.md text
*.html text
*.css text
*.scss text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tgz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
