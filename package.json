{
  "name": "@justedou/tsyringe-auto-register",
  "version": "1.0.0",
  "description": "Auto-registration helper for tsyringe with customizable role detection, icons, and documented API.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json",
    "build:types": "api-extractor run --local",
    "docs": "typedoc",
    "prepublishOnly": "npm run build && npm run build:types",
    "release": "semantic-release",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "tsyringe",
    "di",
    "auto-register",
    "typescript"
  ],
  "author": {
    "name": "Antoine Tsinga"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoineTsinga/tsyringe-auto-register.git"
  },
  "bugs": {
    "url": "https://github.com/antoineTsinga/tsyringe-auto-register/issues"
  },
  "homepage": "https://github.com/antoineTsinga/tsyringe-auto-register#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "provenance": true
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "fast-glob": "^3.3.2",
    "tsyringe": "^4.8.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.47.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^22.0.0",
    "semantic-release": "^24.2.9",
    "typedoc": "^0.26.0",
    "typescript": "^5.6.0"
  }
}
